# =============================================================================
# Leo Legacy — Environment variables template
# =============================================================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# Quarkus reads .env automatically (SmallRye Config).
# Never commit the .env file — it is gitignored.
# =============================================================================

# AI provider API key (OpenAI, Anthropic, or "not-needed" for local vLLM)
AI_API_KEY=your-api-key-here
